# Kiosco POS - sincronización con PocketBase (self-hosted en LAN)

# URL del servidor PocketBase de la sucursal (red local). Se usa como valor por
# defecto si no se configura explícitamente en la pantalla Configuración.
POCKETBASE_URL=http://192.168.100.6:8090

# Token de acceso opcional. Si se deja vacío, el terminal utiliza las reglas
# de lectura/escritura públicas de las colecciones (ver pocketbase_schema.json).
POCKETBASE_TOKEN=